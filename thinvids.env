TZ=US/Pacific

REDIS_HOST=swarm1
REDIS_PORT=6379
REDIS_DB_TASKS=0
REDIS_DB_DATA=1
HUEY_NAME=thinvidstasks
HUEY_PIPELINE_BASE_NAME=thinvidstasks:pipeline
HUEY_PIPELINE_NAME=thinvidstasks:pipeline
HUEY_ENCODE_NAME=thinvidstasks:encode

CONFIG_ROOT=/config
WATCH_ROOT=/watch
SOURCE_MEDIA_ROOT=/source_media
LIBRARY_ROOT=/library
PROCESSED_FILE=/config/processed.log
WATCHER_ENV_FILE=/config/watcher.env
NFS_PROJECT_ROOT=/library/.thinvids-projects
MASTER_HTTP_PORT=8000

WATCHER_CONTROL_MODE=docker
WATCHER_CONTAINER=thinvids_watcher
MANAGER_SSH_USER=jerry
MANAGER_SSH_KEY_PATH=/root/.ssh/id_ed25519
MANAGER_SSH_KNOWN_HOSTS=/tmp/thinvids_known_hosts

ADOPT_EXISTING_PROCESSED_ON_STARTUP=1
ADOPT_EXISTING_PROCESSED_MARKER=/config/processed.log.watch.adopted
PROCESSED_PATH_ALIASES=tv=television
USE_WATCHDOG=1
USE_SCANNER=1
SCAN_INTERVAL_SEC=60
STABLE_CHECKS=5
STABLE_DELAY_SEC=10
WORKERS=4
SUBMIT_URL=http://127.0.0.1:5005/add_job

WOL_BROADCASTS=255.255.255.255
WOL_PORT=9
WOL_REPEATS=3
