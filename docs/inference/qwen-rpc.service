[Unit]
Description=Dedicated llama.cpp CPU RPC worker
After=network-online.target
Wants=network-online.target
Conflicts=qwen-inference.service

[Service]
Type=simple
User=inference
Group=inference
WorkingDirectory=/opt/inference/llama.cpp
ExecStart=/opt/inference/llama.cpp/build/bin/ggml-rpc-server --host 127.0.0.1 --port 50052 --device CPU --threads 4 --cache
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
StateDirectory=inference
Environment=LLAMA_CACHE=/var/lib/inference/cache
InaccessiblePaths=-/watch -/library -/source_media -/projects -/opt/jerry

[Install]
WantedBy=multi-user.target
